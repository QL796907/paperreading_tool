{
  "name": "paper-glossary",
  "version": "1.0.1",
  "private": true,
  "description": "论文术语笔记本，可从 Zotero 选中文字一键加入",
  "author": "hy",
  "type": "module",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/QL796907/paperreading_tool.git"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"node --watch server/index.js\" \"vite --config web/vite.config.js\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/index.js",
    "plugin:pack": "node scripts/pack-plugin.js",
    "icons:win": "node scripts/make-win-icon.js",
    "electron": "npm run build && electron .",
    "dist": "npm run build && npm run icons:win && electron-builder --win nsis --publish never",
    "dist:proxy": "node scripts/with-proxy.js dist",
    "release": "npm run build && npm run icons:win && electron-builder --win nsis --publish always",
    "release:proxy": "node scripts/with-proxy.js release",
    "android:setup": "npm run build && node scripts/setup-android.js",
    "apk": "npm run android:setup && node scripts/build-apk.js",
    "apk:proxy": "node scripts/with-proxy.js apk"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.3",
    "cors": "^2.8.5",
    "electron-updater": "^6.3.9",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.ql796907.paper-glossary",
    "productName": "术语本",
    "copyright": "Copyright © hy",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "web/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/tray.png",
        "to": "tray.png"
      },
      {
        "from": "electron/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "paper-glossary-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "术语本",
      "unicode": true,
      "installerLanguages": ["zh_CN"],
      "language": "2052",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "QL796907",
      "repo": "paperreading_tool"
    },
    "electronLanguages": ["zh-CN", "en-US"]
  }
}
